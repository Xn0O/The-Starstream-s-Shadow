    - {fileID: 1281587436}
    - {fileID: 889522938}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u91CA\u653E\u7684\u4F24\u5BB3\u548C\u56DE\u590D\u7684\u8840\u91CF\u4F1A\u6839\u636E\u5C42\u6570\u83B7\u5F97\u4E0D\u540C[yellow]\u52A0\u6210[/yellow]\uFF0C\u6309\u7167[grey]0[/grey]/[yellow]6[/yellow]/[red]20[/red]\u7684\u52A0\u6210\u5206\u7EA7"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1669294269}
    - {fileID: 1935915358}
    - {fileID: 1967426416}
    - {fileID: 889522938}
    hideObjects:
    - {fileID: 449872856}
    - {fileID: 1281587436}
    - {fileID: 448108448}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u4F60\u53EF\u4EE5\u5C1D\u8BD5[yellow]\u64CD\u4F5C\u4E00\u4E0B[/yellow]\uFF0C\u6309\u4E0BWASD\u79FB\u52A8\uFF0C\u5438\u6536\u4F24\u5BB3[red]\u53E0\u52A0\u5C42\u6570[/red]"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 449872856}
    - {fileID: 1281587436}
    - {fileID: 1935915358}
    - {fileID: 448108448}
    hideObjects:
    - {fileID: 1669294269}
    - {fileID: 889522938}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u5982\u679C\u654C\u4EBA\u5468\u56F4\u6709[red]\u8303\u56F4\u6307\u793A[/red]\uFF0C\u6700\u597D\u4E0D\u8981\u9760\u8FD1\uFF0C\u6BD4\u5982\u8FD9\u56E2\u706B\u7684\u5468\u56F4\u7684\u4E00\u5708"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 449872856}
    - {fileID: 1281587436}
    - {fileID: 1935915358}
    - {fileID: 245120448}
    hideObjects:
    - {fileID: 448108448}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u654C\u4EBA\u4F1A\u5BF9\u8FD9\u4E2A\u8303\u56F4\u9020\u6210\u6301\u7EED[red]\u9AD8\u989D\u7684\u4F24\u5BB3[/red]"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 449872856}
    - {fileID: 1281587436}
    - {fileID: 1935915358}
    - {fileID: 245120448}
    hideObjects:
    - {fileID: 614991728}
    - {fileID: 448108448}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u5982\u679C\u4F60\u5DF2\u7ECF\u5B66\u4F1A\u64CD\u4F5C\u7684\u8BDD\n\u6211\u5C31\u544A\u8BC9\u4F60\u63A5\u4E0B\u6765\u9700\u8981\u505A\u4E9B\u4EC0\u4E48\uFF01"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 449872856}
    - {fileID: 1281587436}
    - {fileID: 1935915358}
    hideObjects:
    - {fileID: 614991728}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u8FD9\u5468\u68EE\u6797\u91CC\u51FA\u73B0\u4E86\u4E24\u53EA\u602A\u7269\uFF0C\u6211\u88AB\u6D3E\u53BB\u8D1F\u8D23\u9A71\u9010\u5B83\u4EEC"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 614991728}
    hideObjects:
    - {fileID: 449872856}
    - {fileID: 1935915358}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u56FE\u9274\u91CC\u597D\u50CF\u8BB0\u8F7D\u7740\u5B83\u4EEC\u7684\u5F31\u70B9\uFF0C\u6211\u770B\u770B......"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 614991728}
    hideObjects:
    - {fileID: 449872856}
    - {fileID: 1935915358}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u9ED1\u9ED1\u6076\u9B54\u53EA\u6709\u5728[red]\u3010\u663E\u5F62\u3011[/red]\u7684\u65F6\u5019\u624D\u80FD\u4F24\u5BB3\u5230\u5B83\uFF0C\u6240\u4EE5\u5728\u8FD9\u4E4B\u524D\u9700\u8981\u6328\u6253\u53E0\u52A0\u5C42\u6570"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 614991728}
    hideObjects:
    - {fileID: 449872856}
    - {fileID: 1935915358}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u7EA2\u7EA2\u6076\u9B54\u4F1A\u53EC\u5524[red]\u968F\u4ECE[/red]\uFF0C\u5F53\u968F\u4ECE\u671D\u4F60\u51B2\u649E\u65F6\uFF0C\u53EA\u8981[yellow]\u91CA\u653E\u65F6\u673A[/yellow]\u5408\u9002\uFF0C\u4F60\u5C31\u53EF\u4EE5[red]\u3010\u53CD\u5F39\u3011[/red]\u968F\u4ECE"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 614991728}
    hideObjects:
    - {fileID: 449872856}
    - {fileID: 1935915358}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "[red]\u3010\u53CD\u5F39\u3011[/red]\u7684\u968F\u4ECE\u4F1A\u5BF9\u7EA2\u8272\u6076\u9B54\u9020\u6210[orange]\u5DE8\u989D\u4F24\u5BB3[/orange]\uFF01\uFF01\uFF01\uFF01\n"
