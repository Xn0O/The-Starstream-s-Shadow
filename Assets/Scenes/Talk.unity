--- !u!114 &2013036322
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2013036321}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d28d26a0c71bb8347b93b0ce152fd877, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialogueText: {fileID: 1174637472}
  dialoguePanel: {fileID: 814083879}
  pageCounterText: {fileID: 147960775}
  continueIndicator: {fileID: 964679742}
  dialoguePages:
  - text: "\u5173\u4E8E\u5BF9\u8BDD.\nE - \u7EE7\u7EED\u5BF9\u8BDD\nQ - \u4E0A\u4E00\u53E5\u8BDD"
    showObjects:
    - {fileID: 802265142}
    - {fileID: 267922461}
    hideObjects:
    - {fileID: 1386551313}
    - {fileID: 1281587436}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "Tab - \u67E5\u770B/\u5173\u95ED\u7EDF\u8BA1\u4FE1\u606F\n[grey]\u53EF\u4EE5\u67E5\u770B\u6700\u9AD8\u4E00\u51FB\u3001\u627F\u53D7\u4F24\u5BB3\u3001\u6700\u9AD8\u6CBB\u7597\u3001\u7D2F\u79EF\u661F\u7EB9[/grey]"
    showObjects:
    - {fileID: 802265142}
    - {fileID: 267922461}
    - {fileID: 1935915358}
    hideObjects:
    - {fileID: 627001562}
    - {fileID: 1386551313}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u5148\u6765\u81EA\u6211\u4ECB\u7ECD\u4E00\u4E0B\uFF01\uFF01"
    showObjects:
    - {fileID: 627001562}
    - {fileID: 267922461}
    - {fileID: 1935915358}
    hideObjects: []
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u6211\u662F\u4E00\u540D\u5929\u4F7F\uFF0C\u540D\u5B57\u53EB\u505AAio"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1935915358}
    hideObjects:
    - {fileID: 1669294269}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u6BCF\u4F4D\u5929\u4F7F\u4ECE\u8BDE\u751F\u5F00\u59CB\u5C31\u62E5\u6709\u4E00\u4EF6\u4FE1\u7269\uFF0C\u4FE1\u7269\u8D4B\u4E88\u5929\u4F7F\u4E0D\u540C\u7684\u80FD\u529B"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1669294269}
    - {fileID: 1935915358}
    hideObjects:
    - {fileID: 1580478148}
    - {fileID: 1967426416}
    - {fileID: 6891827257382835755}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u6211\u7684\u4FE1\u7269\u662F\u80CC\u5305\uFF0C\u53EF\u4EE5[red]\u5438\u6536\u4F24\u5BB3[/red]\u5E76\u5B58\u50A8\u8D77\u6765"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1669294269}
    - {fileID: 1935915358}
    - {fileID: 1967426416}
