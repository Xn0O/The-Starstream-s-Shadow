    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u5DE6\u4E0A\u89D2\u7684\u661F\u7EB9\u5C31\u662F\u5B58\u50A8\u7684[red]\u5C42\u6570[/red],\u8FD9\u91CC\u6CA1\u6709\u663E\u793A\u662F\u56E0\u4E3A\u88AB\u6253\u7684\u4E0D\u662F\u6211..."
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1669294269}
    - {fileID: 1935915358}
    - {fileID: 1580478148}
    - {fileID: 6891827257382835755}
    - {fileID: 1967426416}
    hideObjects: []
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u4F46\u662F\u5FC5\u987B\u5F97\u6328\u6253\u624D\u80FD\u50A8\u5B58\u8D77\u6765\u5462..."
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1669294269}
    - {fileID: 1935915358}
    - {fileID: 1580478148}
    - {fileID: 6891827257382835755}
    - {fileID: 1967426416}
    hideObjects: []
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u526F\u4F5C\u7528\u662F\u50A8\u5B58\u5728\u53E3\u888B\u7684\u80FD\u91CF\u6781\u5176\u4E0D\u7A33\u5B9A\uFF0C\u4F1A\u7F13\u6162[red]\u707C\u70E7[/red]\u81EA\u5DF1[grey]\uFF08\u57FA\u4E8E\u5C42\u6570\uFF09[/grey]"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1669294269}
    - {fileID: 1935915358}
    - {fileID: 1967426416}
    hideObjects:
    - {fileID: 6891827257382835755}
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u6240\u4EE5\u9700\u8981\u53CA\u65F6\u6309\u4E0B[yellow]\u7A7A\u683C\u952E[/yellow]\u91CA\u653E\u80FD\u91CF\uFF0C\u4F60\u53EF\u4EE5\u5C1D\u8BD5\u6309\u4E00\u4E0B\uFF0C\u91CA\u653E\u7684\u80FD\u91CF\u4F1A\u5BF9\u5468\u56F4\u9020\u6210[red]\u4F24\u5BB3[/red]"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1669294269}
    - {fileID: 1935915358}
    - {fileID: 1967426416}
    hideObjects: []
    useTypewriter: 1
    typingSpeed: 20
    typingSound: {fileID: 8300000, guid: 85dd71b50e5eda34eaf1d3a378f966ae, type: 3}
    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u5E76\u4E14\u91CA\u653E\u80FD\u91CF\u540E\u4F1A[green]\u56DE\u590D\u751F\u547D[/green][grey]\uFF08\u57FA\u4E8E\u5C42\u6570\uFF09[/grey]"
    showObjects:
    - {fileID: 1386551313}
    - {fileID: 267922461}
    - {fileID: 1669294269}
    - {fileID: 1935915358}
    - {fileID: 1967426416}
    hideObjects:
