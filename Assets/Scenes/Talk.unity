    pageSound: {fileID: 8300000, guid: 621f4344621af344f8fd84024cb66e33, type: 3}
  - text: "\u4E00\u5B9A\u8981\u8BB0\u4F4F\u5B83\u4EEC\u7684[orange]\u5F31\u70B9[/orange]\u5662\uFF01\uFF01"
    showObjects:
